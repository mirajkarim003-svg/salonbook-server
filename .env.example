# ---------- Server ----------
PORT=5000

# ---------- MongoDB ----------
# Atlas connection string. SAME database must be used by the client (Better Auth).
MONGODB_URI=
DB_NAME=salonbook

# ---------- Client / Auth ----------
# Frontend URL(s) allowed by CORS. Separate multiple URLs with a comma.
CLIENT_URL=http://localhost:3000
# The URL where the Next.js client (Better Auth) runs. The server downloads the
# public keys from  <AUTH_URL>/api/auth/jwks  to verify login tokens (JWT).
AUTH_URL=http://localhost:3000

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
